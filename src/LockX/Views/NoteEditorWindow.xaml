<Window x:Class="LockX.Views.NoteEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="640" Height="520" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
        <TextBox x:Name="TitleBox" Grid.Row="1" Margin="0,0,0,10" FontSize="15" MaxLength="200" />
        <TextBox x:Name="BodyBox" Grid.Row="2" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontSize="14"
                 TextChanged="OnBodyChanged" />
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="Count" VerticalAlignment="Center" Style="{StaticResource Secondary}" FontSize="12" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" MinWidth="80" />
                <Button Content="Save" Style="{StaticResource AccentButtonStyle}" MinWidth="80" Click="OnSave" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
