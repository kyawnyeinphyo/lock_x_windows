<UserControl x:Class="LockX.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:LockX.Views"
             AllowDrop="True" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
    <UserControl.Resources>
        <ContextMenu x:Key="ItemMenu">
            <MenuItem Header="Open" Click="OnMenuOpen" />
            <MenuItem Header="Rename…" Click="OnMenuRename" />
            <MenuItem Header="Export…" Click="OnMenuExport" />
            <Separator />
            <MenuItem Header="Delete" Click="OnMenuDelete" />
        </ContextMenu>

        <!-- Grid cell for images and videos -->
        <DataTemplate x:Key="GridTemplate" DataType="{x:Type v:ItemVM}">
            <StackPanel Width="148" Margin="4">
                <Grid Height="116">
                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" />
                    <TextBlock Style="{StaticResource IconText}" Text="{Binding Glyph}" FontSize="30"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Visibility="{Binding GlyphVisibility}" />
                    <Border CornerRadius="8" SnapsToDevicePixels="True">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <Grid VerticalAlignment="Bottom" Margin="6" Visibility="{Binding PlayBadgeVisibility}">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE768;" FontSize="12" Foreground="White"
                                   HorizontalAlignment="Left" />
                        <Border HorizontalAlignment="Right" Background="#99000000" CornerRadius="9" Padding="6,1"
                                Visibility="{Binding DurationVisibility}">
                            <TextBlock Text="{Binding DurationText}" FontSize="11" Foreground="White" />
                        </Border>
                    </Grid>
                </Grid>
                <TextBlock Text="{Binding Name}" Margin="2,6,2,0" FontSize="12" TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center" MaxWidth="144" ToolTip="{Binding Name}" />
            </StackPanel>
        </DataTemplate>

        <!-- Row for files and notes -->
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type v:ItemVM}">
            <Grid Margin="4,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource IconText}" Text="{Binding Glyph}" FontSize="18"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Style="{StaticResource Secondary}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <WrapPanel Margin="8" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="StackPanelTemplate">
            <VirtualizingStackPanel />
        </ItemsPanelTemplate>

        <DataTemplate x:Key="KindTemplate" DataType="{x:Type v:KindVM}">
            <Grid Margin="2,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource IconText}" Text="{Binding Glyph}" FontSize="15" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="12" VerticalAlignment="Center"
                           Style="{StaticResource Secondary}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="12,10,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolButton}" Click="OnAddFiles" ToolTip="Add files to the vault (Ctrl+O)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE710;" Margin="0,0,8,0" />
                        <TextBlock Text="Add files" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="OnNewNote" ToolTip="Create a note (Ctrl+N)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE70F;" Margin="0,0,8,0" />
                        <TextBlock Text="New note" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Grid Grid.Column="1" MaxWidth="320" Margin="12,0">
                <TextBox x:Name="Search" TextChanged="OnSearchChanged" VerticalContentAlignment="Center" />
                <TextBlock x:Name="SearchHint" Text="Search" IsHitTestVisible="False" Margin="12,0,0,0"
                           VerticalAlignment="Center" Style="{StaticResource Tertiary}" />
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="ExportButton" Style="{StaticResource ToolButton}" Click="OnExport" IsEnabled="False"
                        ToolTip="Export the selected item (unencrypted)">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE74E;" />
                </Button>
                <Button x:Name="DeleteButton" Style="{StaticResource ToolButton}" Click="OnDelete" IsEnabled="False"
                        ToolTip="Delete (Del)">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE74D;" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="OnSettings" ToolTip="Settings">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE713;" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="OnLock" ToolTip="Lock the vault (Ctrl+Shift+L)" Margin="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE72E;" Margin="0,0,8,0" />
                        <TextBlock Text="Lock" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="160" MaxWidth="260" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="340" MinWidth="280" MaxWidth="480" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <DockPanel Grid.Column="0">
                <Border DockPanel.Dock="Bottom" Padding="14,10" BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE785;" Foreground="#2EA44F" Margin="0,0,8,0" />
                            <TextBlock Text="Unlocked" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="Countdown" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Style="{StaticResource Secondary}" ToolTip="Time until the vault locks itself" />
                    </Grid>
                </Border>
                <ListBox x:Name="Sidebar" ItemTemplate="{StaticResource KindTemplate}" BorderThickness="0"
                         Background="Transparent" Margin="6,0" SelectionChanged="OnKindChanged"
                         FocusVisualStyle="{x:Null}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>

            <!-- Items -->
            <Border Grid.Column="1" BorderThickness="1,0,1,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                <Grid>
                    <ListBox x:Name="Items" SelectionMode="Extended" BorderThickness="0" Background="Transparent"
                             FocusVisualStyle="{x:Null}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnSelectionChanged" KeyDown="OnItemsKey"
                             MouseDoubleClick="OnItemsDoubleClick" PreviewMouseRightButtonDown="OnItemsRightClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="ContextMenu" Value="{StaticResource ItemMenu}" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock x:Name="EmptyGlyph" Style="{StaticResource IconText}" FontSize="44"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="EmptyTitle" FontSize="17" Margin="0,10,0,0" HorizontalAlignment="Center"
                                   Style="{StaticResource Secondary}" />
                        <TextBlock x:Name="EmptyHint" FontSize="13" Margin="0,4,0,0" HorizontalAlignment="Center"
                                   Style="{StaticResource Tertiary}" />
                    </StackPanel>

                    <Border x:Name="DropHighlight" Margin="8" BorderThickness="3" CornerRadius="12" Visibility="Collapsed"
                            BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" IsHitTestVisible="False" />
                </Grid>
            </Border>

            <!-- Detail -->
            <Grid Grid.Column="2" Margin="18">
                <TextBlock x:Name="NoSelection" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Style="{StaticResource Tertiary}" FontSize="14" />

                <ScrollViewer x:Name="DetailPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <Border x:Name="Poster" Height="200" CornerRadius="10" Cursor="Hand"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                MouseLeftButtonUp="OnPosterClick">
                            <Grid>
                                <TextBlock x:Name="PosterGlyph" Style="{StaticResource IconText}" FontSize="48"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <Image x:Name="PosterImage" Stretch="Uniform" Margin="2" />
                                <Border x:Name="PosterPlay" Visibility="Collapsed" Width="48" Height="48" CornerRadius="24"
                                        Background="#88000000">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE768;" Foreground="White" FontSize="18" />
                                </Border>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="DetailName" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,16,0,12" />
                        <Grid x:Name="Facts">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button x:Name="OpenButton" Content="Open" Style="{StaticResource AccentButtonStyle}" Click="OnOpen"
                                    Padding="20,6" Margin="0,0,8,0" />
                            <Button x:Name="EditButton" Content="Edit" Click="OnEditNote" Margin="0,0,8,0" Visibility="Collapsed" />
                            <Button Content="Export…" Click="OnExport" Margin="0,0,8,0" />
                            <Button Content="Delete" Click="OnDelete" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Viewer + busy overlays cover everything, including the toolbar -->
        <v:ViewerOverlay x:Name="Viewer" Grid.RowSpan="2" />

        <Grid x:Name="Busy" Grid.RowSpan="2" Background="#33000000" Visibility="Collapsed">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,22" CornerRadius="12"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Width="240">
                    <TextBlock x:Name="BusyText" Text="Encrypting…" HorizontalAlignment="Center" />
                    <ProgressBar x:Name="BusyBar" Height="4" Margin="0,14,0,0" Minimum="0" Maximum="1" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
