<UserControl x:Class="LockX.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:LockX.Views">
    <Grid Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
        <StackPanel Width="340" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image Source="pack://application:,,,/Assets/icon.png" Width="84" Height="84" Margin="0,0,0,12" />
            <TextBlock Text="Set up Lock X" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Style="{StaticResource Secondary}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,22"
                       Text="Choose a password for your vault. It is the only way back in if Windows Hello is ever unavailable." />

            <TextBlock Text="Vault password" FontSize="12" Style="{StaticResource Secondary}" Margin="2,0,0,4" />
            <PasswordBox x:Name="Password" PasswordChanged="OnChanged" Margin="0,0,0,12" />
            <TextBlock Text="Confirm password" FontSize="12" Style="{StaticResource Secondary}" Margin="2,0,0,4" />
            <PasswordBox x:Name="Confirm" PasswordChanged="OnChanged" />

            <v:PasswordStrengthBar x:Name="Strength" Margin="0,12,0,4" />
            <TextBlock x:Name="Hint" FontSize="12" MinHeight="18" Style="{StaticResource Secondary}" />

            <CheckBox x:Name="Hello" Visibility="Collapsed" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="Unlock with Windows Hello" />
                    <TextBlock Style="{StaticResource Tertiary}" FontSize="12" TextWrapping="Wrap"
                               Text="Wraps your vault key to a key held by this PC's TPM. It only works on this PC." />
                </StackPanel>
            </CheckBox>

            <TextBlock x:Name="Error" Style="{StaticResource Danger}" Margin="0,12,0,0" Visibility="Collapsed" />

            <Button x:Name="Create" Content="Create Vault" Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Center" MinWidth="160" Margin="0,20,0,0" IsDefault="True"
                    IsEnabled="False" Click="OnCreate" />
        </StackPanel>
    </Grid>
</UserControl>
