<UserControl x:Class="LockX.Views.LockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
        <StackPanel Width="300" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image Source="pack://application:,,,/Assets/icon.png" Width="84" Height="84" Margin="0,0,0,12" />
            <TextBlock Text="Lock X" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="Vault locked" Style="{StaticResource Secondary}" HorizontalAlignment="Center" Margin="0,4,0,24" />

            <StackPanel x:Name="HelloPanel">
                <Button x:Name="HelloButton" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                        Padding="0,10" Click="OnHello">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE928;" Margin="0,0,10,0" />
                        <TextBlock Text="Unlock with Windows Hello" />
                    </StackPanel>
                </Button>
                <Button Content="Use vault password" HorizontalAlignment="Center" Margin="0,12,0,0"
                        Click="OnShowPassword" />
            </StackPanel>

            <StackPanel x:Name="PasswordPanel" Visibility="Collapsed">
                <PasswordBox x:Name="Password" PasswordChanged="OnPasswordChanged" KeyDown="OnPasswordKey" />
                <Button x:Name="UnlockButton" Content="Unlock" Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch" Padding="0,10" Margin="0,12,0,0" IsEnabled="False"
                        Click="OnUnlock" />
                <Button x:Name="BackToHello" Content="Use Windows Hello instead" HorizontalAlignment="Center"
                        Margin="0,12,0,0" Visibility="Collapsed" Click="OnShowHello" />
            </StackPanel>

            <TextBlock x:Name="Error" Style="{StaticResource Danger}" TextAlignment="Center" Margin="0,16,0,0"
                       Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</UserControl>
