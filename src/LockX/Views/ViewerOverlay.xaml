<UserControl x:Class="LockX.Views.ViewerOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" Visibility="Collapsed" KeyDown="OnKeyDown">
    <UserControl.Resources>
        <!-- Flat white-on-dark button that works regardless of the system theme. -->
        <Style x:Key="OverlayButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#FF121212" TextElement.Foreground="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid Grid.Row="0" Margin="12,10,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource OverlayButton}" Click="OnClose" ToolTip="Close (Esc)">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE711;" FontSize="14" />
                </Button>
                <TextBlock x:Name="Position" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.7" FontSize="13" />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="Title" FontSize="15" FontWeight="SemiBold" TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="560" />
                <TextBlock x:Name="Subtitle" FontSize="12" Opacity="0.65" TextAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="EditButton" Style="{StaticResource OverlayButton}" Click="OnEdit" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE70F;" Margin="0,0,8,0" />
                        <TextBlock Text="Edit note" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource OverlayButton}" Click="OnExport">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE74E;" Margin="0,0,8,0" />
                        <TextBlock Text="Export" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="1">
            <!-- Image with wheel zoom + drag pan -->
            <Grid x:Name="ImagePanel" ClipToBounds="True" Background="Transparent" Visibility="Collapsed"
                  MouseWheel="OnImageWheel" MouseLeftButtonDown="OnImageDown" MouseMove="OnImageMove"
                  MouseLeftButtonUp="OnImageUp" Margin="64,0">
                <Image x:Name="Picture" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                       RenderTransformOrigin="0,0">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="Zoom" />
                            <TranslateTransform x:Name="Pan" />
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
                <Button x:Name="FitButton" Content="Fit" Style="{StaticResource OverlayButton}" Click="OnFit"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8" Visibility="Collapsed"
                        Background="#66000000" />
            </Grid>

            <!-- Video -->
            <Grid x:Name="VideoPanel" Visibility="Collapsed" Margin="64,0,64,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform"
                              MediaOpened="OnMediaOpened" MediaEnded="OnMediaEnded" MediaFailed="OnMediaFailed"
                              MouseLeftButtonUp="OnPlayerClick" />
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PlayButton" Style="{StaticResource OverlayButton}" Click="OnPlayPause" Width="44">
                        <TextBlock x:Name="PlayGlyph" Style="{StaticResource IconText}" Text="&#xE768;" FontSize="16" />
                    </Button>
                    <TextBlock x:Name="Elapsed" Grid.Column="1" Text="0:00" VerticalAlignment="Center" Margin="8,0" Opacity="0.8" />
                    <Slider x:Name="Seek" Grid.Column="2" Minimum="0" Maximum="1" VerticalAlignment="Center"
                            ValueChanged="OnSeek" IsMoveToPointEnabled="True" />
                    <TextBlock x:Name="Total" Grid.Column="3" Text="0:00" VerticalAlignment="Center" Margin="8,0" Opacity="0.8" />
                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE767;" Margin="4,0,6,0" Opacity="0.8" />
                        <Slider x:Name="Volume" Width="90" Minimum="0" Maximum="1" Value="0.8" VerticalAlignment="Center"
                                ValueChanged="OnVolume" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Note -->
            <Border x:Name="NotePanel" Visibility="Collapsed" MaxWidth="780" Margin="64,8,64,24"
                    Background="#1E1E1E" CornerRadius="10" Padding="8">
                <TextBox x:Name="NoteText" IsReadOnly="True" TextWrapping="Wrap" FontSize="15" Background="Transparent"
                         BorderThickness="0" Foreground="White" VerticalScrollBarVisibility="Auto" Padding="16" />
            </Border>

            <!-- Other files / unsupported formats -->
            <StackPanel x:Name="FilePanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="460">
                <TextBlock x:Name="FileGlyph" Style="{StaticResource IconText}" Text="&#xE8A5;" FontSize="64" Opacity="0.7" />
                <TextBlock x:Name="FileName" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" Margin="0,16,0,0"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="FileMessage" TextAlignment="Center" TextWrapping="Wrap" Opacity="0.7" Margin="0,8,0,0" />
                <Button Content="Open with default app" Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center" Margin="0,18,0,0" Padding="18,8" Click="OnOpenExternally" />
                <TextBlock Text="Opens a temporary decrypted copy that is deleted when you lock the vault."
                           FontSize="12" Opacity="0.5" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel>

            <TextBlock x:Name="Status" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0.7" Text="Decrypting…" />

            <!-- Previous / next -->
            <Button x:Name="PrevButton" Style="{StaticResource OverlayButton}" HorizontalAlignment="Left"
                    VerticalAlignment="Center" Margin="8,0,0,0" Padding="12,22" Click="OnPrev" ToolTip="Previous (←)">
                <TextBlock Style="{StaticResource IconText}" Text="&#xE76B;" FontSize="18" />
            </Button>
            <Button x:Name="NextButton" Style="{StaticResource OverlayButton}" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Margin="0,0,8,0" Padding="12,22" Click="OnNext" ToolTip="Next (→)">
                <TextBlock Style="{StaticResource IconText}" Text="&#xE76C;" FontSize="18" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
