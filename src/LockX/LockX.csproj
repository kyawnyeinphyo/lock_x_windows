<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LockX</RootNamespace>
    <AssemblyName>LockX</AssemblyName>
    <ApplicationIcon>Assets\LockX.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Lock X</Product>
    <Company>Lock X</Company>
    <Description>Encrypted vault for your photos, videos, files and notes.</Description>
    <!-- Fluent theme (ThemeMode) is still marked experimental in WPF. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LockX.Core\LockX.Core.csproj" />
    <Resource Include="Assets\LockX.ico" />
    <Resource Include="Assets\icon.png" />
  </ItemGroup>
</Project>
